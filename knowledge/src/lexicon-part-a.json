        "write a system prompt",
        "create a system prompt",
        "improve my prompt",
        "fix my prompt",
        "build a prompt"
      ]
    },
    {
      "id": "prompt-diff",
      "name": "Prompt Diff",
      "url": "index.html?tool=prompt-diff",
      "reason": "Use it to compare two prompt versions and see which lines were added or removed. It does not measure whether the model got better.",
      "when": [
        "compare two prompts",
        "compare prompt versions",
        "compare prompts",
        "prompt diff",
        "diff my prompts",
        "what changed in my prompt",
        "prompt regression",
        "prompt versions",
        "two prompt versions",
        "compare two prompt"
      ]
    },
    {
      "id": "fact-anchor-checker",
      "name": "Fact Anchor Checker",
      "url": "tools/fact-anchor-checker.html",
      "reason": "Use it to check claims in an answer against source text you paste. It is a manual spot-check, not a way to stop hallucinations in general.",
      "when": [
        "check claims against",
        "verify claims against",
        "supported by the source",
        "against the evidence",
        "against my source",
        "fact anchor",
        "compare claims to"
      ]
    },
    {
      "id": "pii-secret-redactor",
      "name": "PII & Secret Redactor",
      "url": "tools/pii-secret-redactor.html",
      "reason": "Use it to mask emails, phone numbers and API-key-like strings before you paste text anywhere. Pattern matching is not exhaustive, so read the result.",
      "when": [
        "redact secrets",
        "redact pii",
        "remove secrets",
        "strip secrets",
        "remove pii",
        "mask pii",
        "mask emails",
        "before pasting a prompt",
        "api keys out of",
        "strip api keys"
      ]
    },
    {
      "id": "agentic-workflow-generator",
      "name": "Agentic Workflow Generator",
      "url": "index.html?tool=agentic-workflow-generator",
      "reason": "Use it when you already know you want a workflow and need roles, handoffs, inputs and guardrails written down. It does not explain what an agent is, and it does not run the workflow.",
