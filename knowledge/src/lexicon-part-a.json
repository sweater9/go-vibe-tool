  "tools": [
    {
      "id": "ai-prompt-builder",
      "name": "AI Prompt Builder",
      "url": "tools/ai-prompt-builder.html",
      "reason": "Use it when you are drafting a prompt. It walks through role, request, context, process, tone and output, then assembles one prompt you can copy. It does not call a model.",
