{
  // GoVibeTool V8 — Cloudflare Workers static assets (no Worker script, no backend).
  // The Worker name must match the existing Workers project in the dashboard.
  "$schema": "https://workers.cloudflare.com/wrangler-config-schema.json",
  "name": "go-vibe-tool",
  "compatibility_date": "2026-10-12",
  "assets": {
    // Only the clean output of `npm run build` is uploaded, never the repository root.
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Required by `npx wrangler preview` (Workers Builds preview builds). An empty block adds no bindings, routes,
  // variables or secrets: previews serve the same static assets under the same Worker.
  "previews": {}
}
