{
  "name": "govibe-mahjong-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:8080",
    "MAX_ROOMS_PER_DAY": "150"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "MahjongRoom"
      },
      {
        "name": "REGISTRY",
        "class_name": "RoomRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MahjongRoom",
        "RoomRegistry"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "IP_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "CREATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
