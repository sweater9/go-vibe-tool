{
  // GoVibeTool Phase 2 — ISOLATED preview Worker (static assets only).
  // Deployed only by .github/workflows/cloudflare-phase2-preview.yml. It must never share a name with the
  // production/dashboard Worker ("go-vibe-tool"), and it declares no routes, custom domains or zones.
  "$schema": "https://workers.cloudflare.com/wrangler-config-schema.json",
  "name": "go-vibe-tool-phase2-preview",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
